# ===== CONDUCTOR CERCANO: variables de entorno (prefijo CC_) =====
CC_ENTORNO=desarrollo
# Carpeta de datos (grafos, caché, SQLite). En Render: punto de montaje del disco persistente.
CC_DIRECTORIO_DATOS=./datos
# Base de datos (vacío = SQLite en datos/base_datos/conductor_cercano.db). Ej.: postgresql+psycopg://...
CC_URL_BASE_DATOS=
# Orígenes permitidos por CORS (separados por coma) cuando el frontend se sirve aparte
CC_ORIGENES_CORS=http://localhost:5173,http://127.0.0.1:5173
# Fuente de datos OSM: auto (Overpass y, si falla, extracto) | overpass | extracto
CC_FUENTE_OSM=auto
CC_URLS_OVERPASS=https://overpass-api.de/api,https://overpass.private.coffee/api
CC_TIEMPO_MAXIMO_OVERPASS_S=90
# Extracto PBF de respaldo (BBBike Lima). Alternativa con todo el Perú: https://download.geofabrik.de/south-america/peru-latest.osm.pbf
CC_URL_EXTRACTO_OSM=https://download.bbbike.org/osm/bbbike/Lima/Lima.osm.pbf
CC_AGENTE_USUARIO=ConductorCercano/1.0 (proyecto academico de movilidad)
CC_URL_NOMINATIM=https://nominatim.openstreetmap.org
CC_INTERVALO_MINIMO_NOMINATIM_S=1.1
CC_AREA_MINIMA_DISTRITO_KM2=3
CC_DISTRITO_POR_DEFECTO=miraflores
CC_CONDUCTORES_POR_DEFECTO=1500
CC_PRECARGAR_DISTRITO=true
CC_MAXIMO_CONDUCTORES_POR_MENSAJE=6000
